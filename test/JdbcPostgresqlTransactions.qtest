%modern
%prepend-module-path "${SCRIPT_DIR}/../build"
%requires jni
%requires QUnit
%requires TableMapper
%requires DataProvider
%module-cmd(jni) add-relative-classpath qore-jni-test.jar
# JdbcCursorTest uses the org.qore.lang wrapper classes, which are provided by qore-jni.jar
%module-cmd(jni) add-relative-classpath ../build/qore-jni.jar
%module-cmd(jni) import org.qore.jni.test.JdbcCursorTest
%module-cmd(jni) import java.sql.Types
%exec-class JdbcPostgresqlTransactionsTest

class JdbcPostgresqlTransactionsTest inherits QUnit::Test {
    constructor() : Test("JDBC PostgreSQL transaction integration", "1.0", \ARGV) {
        addTestCase("pooled reads release PostgreSQL locks", \pooledReads());
        addTestCase("commit, rollback, prepared writes and failed reads", \transactions());
        addTestCase("result sets survive Java native-call boundaries", \cursorLifetime());
        addTestCase("prepared results and batch bindings can be reused", \reuse());
        addTestCase("a lost connection replays only a statement that cannot have taken effect", \lostConnection());
        addTestCase("duplicate column names are made unique in lower case", \duplicateNames());
        addTestCase("SQLStatement::describe() describes the result columns", \describeColumns());
        addTestCase("a statement mapper gets the record type of a statement", \statementRecordType());
        set_return_value(main());
    }

    private describeColumns() {
        Datasource ds(connection());
        on_exit ds.rollback();
        ds.execRaw("create temporary table jdbc_describe_test (id integer not null, name varchar(20), "
            "price numeric(10,2), units numeric(12,0), flag boolean, ratio double precision, data bytea, "
            "created timestamp, uid uuid)");
        ds.exec("insert into jdbc_describe_test values (1, 'name', 1.50, 12, true, 0.5, %v, %v, "
            "'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11')", <0102>, 2026-10-21T10:15:30);

        SQLStatement stmt(ds);
        on_exit stmt.close();
        stmt.prepare("select * from jdbc_describe_test");
        stmt.exec();
        hash<auto> desc = stmt.describe();
        assertEq(("id", "name", "price", "units", "flag", "ratio", "data", "created", "uid"), keys desc);
        assertEq({"name": "id", "type": NT_INT, "maxsize": 10, "native_type": "int4", "internal_id": Types::INTEGER,
            "nullable": False}, desc.id);
        assertEq({"name": "name", "type": NT_STRING, "maxsize": 20, "native_type": "varchar",
            "internal_id": Types::VARCHAR, "nullable": True}, desc.name);
        assertEq({"name": "price", "type": NT_NUMBER, "maxsize": 10, "native_type": "numeric",
            "internal_id": Types::NUMERIC, "nullable": True, "precision": 10, "scale": 2}, desc.price);
        assertEq(NT_INT, desc.units.type);
        assertEq(NT_BOOLEAN, desc.flag.type);
        assertEq(NT_FLOAT, desc.ratio.type);
        assertEq(NT_BINARY, desc.data.type);
        assertEq(NT_DATE, desc.created.type);
        # a java.util.UUID is returned as a Java object
        assertEq(NT_OBJECT, desc.uid.type);
        assertEq("uuid", desc.uid.native_type);
        foreach hash<auto> col in (desc.iterator()) {
            assertEq(("name", "type", "maxsize", "native_type", "internal_id", "nullable")
                + (col.name =~ /^(price|units)$/ ? ("precision", "scale") : ()), keys col, col.name);
        }

        # the described type of each column is the type of its value
        assertTrue(stmt.next());
        hash<auto> row = stmt.fetchRow();
        foreach string col in (keys row) {
            assertEq(row{col}.typeCode(), desc{col}.type, col);
        }
        # after the last row, the result set is still described
        assertFalse(stmt.next());
        assertEq(desc, stmt.describe());

        # SQL without a result set has no columns
        stmt.prepare("update jdbc_describe_test set units = 13");
        stmt.exec();
        assertEq({}, stmt.describe());
    }

    private statementRecordType() {
        # TableMapper builds the input record of a raw SQL statement mapper with SQLStatement::describe()
        Datasource ds(connection());
        *hash<string, AbstractDataField> rec = RawSqlStatementOutboundMapper::getStaticInputRecord(ds,
            "select 1::int4 as id, 'x'::varchar(20) as name, 1.5::numeric(10,2) as price");
        assertEq({"id": "int", "name": "string", "price": "number"},
            (map {$1.key: $1.value.getType().getName()}, rec.pairIterator()));
        assertEq("varchar(20)", rec.name.getDescription());
        assertFalse(ds.inTransaction());
    }

    private duplicateNames() {
        Datasource ds(connection());
        on_exit ds.rollback();
        assertEq({"id": (1,), "id_1": (2,), "id_2": (3,)}, ds.select("select 1 as \"Id\", 2 as \"ID\", 3 as id"));
    }

    private cursorLifetime() {
        DatasourcePool ds(connection());
        assertEq(({"id": 11}, {"id": 22}), JdbcCursorTest::readRows(ds,
            "select 11 as id union all select 22 as id order by id"));
        assertEq((), JdbcCursorTest::readRows(ds, "select 1 as id where false"));
        assertFalse(ds.inTransaction());
        assertNoIdleTransactions(ds);
    }

    #! terminates the server session of a datasource; waits until it has ended
    private terminateSession(AbstractDatasource observer, int pid) {
        assertTrue(observer.selectRow("select pg_terminate_backend(%v, 10000) as done", pid).done);
        observer.rollback();
    }

    private lostConnection() {
        string connstr = connection();
        Datasource observer(connstr);
        Datasource ds(connstr);
        string table = "jdbc_lost_connection_test_" + getpid();
        observer.execRaw(sprintf("drop table if exists %s; create table %s (id integer)", table, table));
        observer.commit();
        # executed in reverse order: the rollbacks release the locks the drop waits for
        on_exit {
            observer.execRaw(sprintf("drop table if exists %s", table));
            observer.commit();
        }
        on_exit observer.rollback();
        on_exit ds.rollback();

        # the first statement of a transaction runs once more on the new connection
        terminateSession(observer, ds.selectRow("select pg_backend_pid() as pid").pid);
        assertEq(1, ds.exec(sprintf("insert into %s values (1)", table)));
        ds.commit();
        assertEq(1, observer.selectRow(sprintf("select count(*) as count from %s", table)).count);
        observer.rollback();

        # a read outside a transaction runs in auto-commit mode and is not executed again; the datasource is
        # reconnected
        terminateSession(observer, ds.selectRow("select pg_backend_pid() as pid").pid);
        assertThrows("JNI-ERROR", sub () { ds.select("select 1 as a"); });
        assertEq({"a": (1,)}, ds.select("select 1 as a"));

        # in an active transaction the work is lost: reported, never replayed
        ds.exec(sprintf("insert into %s values (2)", table));
        terminateSession(observer, ds.selectRow("select pg_backend_pid() as pid").pid);
        assertThrows("JDBC-TRANSACTION-ERROR", sub () { ds.exec(sprintf("insert into %s values (3)", table)); });
        ds.rollback();
        assertEq(1, observer.selectRow(sprintf("select count(*) as count from %s", table)).count);
    }

    private string connection() {
        if (!ENV.QORE_DB_CONNSTR_JDBC_PGSQL) {
            testSkip("QORE_DB_CONNSTR_JDBC_PGSQL is not configured");
        }
        return ENV.QORE_DB_CONNSTR_JDBC_PGSQL;
    }

    private reuse() {
        Datasource ds(connection());
        ds.execRaw("create temporary table jdbc_reuse_test (id integer primary key, value integer)");
        ds.commit();
        SQLStatement stmt(ds);
        stmt.prepare("insert into jdbc_reuse_test values (%v, %v)", (1, 2), (10, 20));
        stmt.exec();
        assertEq(2, stmt.affectedRows());
        stmt.commit();
        stmt.bind(3, 30);
        stmt.exec();
        assertEq(1, stmt.affectedRows());
        stmt.commit();
        stmt.bind((4, 5), (40, {}));
        assertThrows("JDBC-BIND-ERROR", \stmt.exec());
        stmt.bind((6, 7), (60, 70));
        stmt.exec();
        assertEq(2, stmt.affectedRows());
        stmt.commit();
        assertEq((1, 2, 3, 6, 7), ds.select("select id from jdbc_reuse_test order by id").id);
        stmt.bind((), (80,));
        assertThrows("JDBC-BIND-ERROR", \stmt.exec());
        stmt.rollback();
        stmt.bind((), ());
        stmt.exec();
        assertEq(0, stmt.affectedRows());
        stmt.commit();

        SQLStatement query(ds);
        query.prepare("select id from jdbc_reuse_test where id >= %v order by id", 6);
        query.exec();
        assertTrue(query.next());
        assertEq({"id": 6}, query.fetchRow());
        query.bind(7);
        query.exec();
        assertTrue(query.next());
        assertEq({"id": 7}, query.fetchRow());
        assertFalse(query.next());
        query.rollback();

        assertThrows("JDBC-BIND-ERROR", sub () {
            ds.exec("insert into jdbc_reuse_test values (%v, %v)", 8, {});
        });
        ds.rollback();
        assertEq(5, ds.selectRow("select count(*) as count from jdbc_reuse_test").count);
    }

    private assertNoIdleTransactions(AbstractDatasource observer) {
        # Inspect actual server state, including idle connections returned to the pool.
        assertEq(0, observer.selectRow("select count(*) as count from pg_stat_activity "
            "where usename = current_user and datname = current_database() "
            "and state like 'idle in transaction%' and pid <> pg_backend_pid()").count);
    }

    private pooledReads() {
        string connstr = connection();
        Datasource configuration(connstr);
        hash<auto> options = configuration.getConfigHash();
        options.options += {"min": 2, "max": 2};
        DatasourcePool ds(options);
        Datasource observer(connstr);
        ds.execRaw("create table jdbc_pool_transaction_test (id integer)");
        ds.commit();
        on_exit {
            ds.rollback();
            observer.execRaw("drop table if exists jdbc_pool_transaction_test");
            observer.commit();
        }
        ds.select("select * from jdbc_pool_transaction_test");
        assertNoIdleTransactions(observer);
        ds.selectRows("select * from jdbc_pool_transaction_test");
        assertNoIdleTransactions(observer);
        ds.selectRow("select count(*) as count from jdbc_pool_transaction_test");
        assertNoIdleTransactions(observer);
        ds.selectColumnar("select * from jdbc_pool_transaction_test");
        assertNoIdleTransactions(observer);
        # NOWAIT makes the former pool self-deadlock a deterministic immediate failure.
        observer.execRaw("lock table jdbc_pool_transaction_test in access exclusive mode nowait");
        observer.rollback();
        assertFalse(ds.inTransaction());
    }

    private transactions() {
        string connstr = connection();
        Datasource configuration(connstr);
        hash<auto> options = configuration.getConfigHash();
        options.options += {"min": 2, "max": 2};
        DatasourcePool ds(options);
        Datasource observer(connstr);
        ds.execRaw("create table jdbc_transaction_test (id integer primary key)");
        ds.commit();
        on_exit {
            ds.rollback();
            observer.execRaw("drop table if exists jdbc_transaction_test");
            observer.commit();
        }
        ds.exec("insert into jdbc_transaction_test values (%v)", 1);
        assertEq(0, observer.selectRow("select count(*) as count from jdbc_transaction_test").count);
        ds.rollback();
        assertEq(0, observer.selectRow("select count(*) as count from jdbc_transaction_test").count);
        ds.exec("insert into jdbc_transaction_test values (%v)", 2);
        ds.commit();
        assertEq(1, observer.selectRow("select count(*) as count from jdbc_transaction_test").count);

        SQLStatement stmt(ds);
        stmt.prepare("insert into jdbc_transaction_test values (%v)", 3);
        stmt.exec();
        assertEq(1, observer.selectRow("select count(*) as count from jdbc_transaction_test").count);
        stmt.rollback();
        assertEq(1, observer.selectRow("select count(*) as count from jdbc_transaction_test").count);
        stmt.exec();
        stmt.commit();
        assertEq(2, observer.selectRow("select count(*) as count from jdbc_transaction_test").count);

        ds.beginTransaction();
        ds.selectRow("select * from jdbc_transaction_test where id = 2 for update");
        assertTrue(ds.inTransaction());
        ds.rollback();
        assertNoIdleTransactions(observer);
        assertThrows("JNI-ERROR", sub () { ds.selectRow("select 1 / 0"); });
        assertEq(2, ds.selectRow("select count(*) as count from jdbc_transaction_test").count);
        assertNoIdleTransactions(observer);
    }
}
