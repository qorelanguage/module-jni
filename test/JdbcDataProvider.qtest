%modern

%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires QUnit
%requires Util
%requires DataProvider
%requires ConnectionProvider
%requires jni
%requires JdbcDataProvider

# the helper classes of the module, to create a table provider without a connection
%module-cmd(jni) import org.qore.dataprovider.jdbc.JdbcSchemaIntrospector
%module-cmd(jni) import org.qore.dataprovider.jdbc.JdbcQueryExecutor
# the test JDBC driver, for statements with scripted results
%module-cmd(jni) add-relative-classpath qore-jni-test.jar
%module-cmd(jni) import org.qore.jni.test.JdbcTransactionDriver

%exec-class JdbcDataProviderTest

public class JdbcDataProviderTest inherits QUnit::Test {
    private {
        *string jdbc_url;
        *string jdbc_user;
        *string jdbc_password;
        *string jdbc_classpath;
        *string jdbc_driver_class;
    }

    constructor() : Test("JdbcDataProviderTest", "1.0", \ARGV) {
        # the connection is a jdbc datasource string, as for the jdbc driver tests (ex:
        # "jdbc:user/pass@ignored{url=postgresql://host:5432/db,classpath=/path/postgresql.jar}")
        if (ENV.QORE_DB_CONNSTR_JDBC_PGSQL) {
            hash<auto> ds = parse_datasource(ENV.QORE_DB_CONNSTR_JDBC_PGSQL);
            string url = ds.options.url ?? ds.db;
            jdbc_url = url =~ /^jdbc:/ ? url : "jdbc:" + url;
            jdbc_user = ds.user;
            jdbc_password = ds.pass;
            jdbc_classpath = ds.options.classpath;
            # a driver loaded with the classpath option must be registered with its class
            jdbc_driver_class = ENV.JDBC_DB_DRIVER_CLASS
                ?? (jdbc_url =~ /^jdbc:postgresql:/ ? "org.postgresql.Driver" : NOTHING);
        }

        addTestCase("factory test", \testFactory());
        addTestCase("action registration", \testActionRegistration());
        addTestCase("negative: missing url", \testNegativeMissingUrl());
        addTestCase("negative: missing user", \testNegativeMissingUser());
        addTestCase("child providers", \testChildProviders());
        addTestCase("query provider", \testQueryProvider());
        addTestCase("tables provider", \testTablesProvider());
        addTestCase("table provider info", \testTableProviderInfo());
        addTestCase("query executor: update counts of all statements", \testQueryExecutorCounts());
        addTestCase("query executor: errors of later statements", \testQueryExecutorErrors());
        addTestCase("query executor: a query returns one result set", \testQueryExecutorOneResultSet());

        set_return_value(main());
    }

    private testFactory() {
        JdbcDataProviderFactory factory();
        assertEq("jdbc-dp", factory.getInfo().name);
    }

    private testActionRegistration() {
        assertEq(True, DataProviderActionCatalog::getApp("JdbcDP").val());
    }

    private testNegativeMissingUrl() {
        assertThrows("JDBC-CONSTRUCTOR-ERROR", sub () {
            new JdbcDataProvider({
                "user": "test",
                "password": "test",
            });
        });
    }

    private testNegativeMissingUser() {
        assertThrows("JDBC-CONSTRUCTOR-ERROR", sub () {
            new JdbcDataProvider({
                "url": "jdbc:postgresql://localhost/test",
            });
        });
    }

    #! statements with scripted results ("multi:" SQL; see JdbcTransactionDriver); like the SQL Server driver, the
    #! test driver reports the results after the first one only when they are read
    private testQueryExecutorCounts() {
        JdbcTransactionDriver::reset();
        JdbcQueryExecutor executor(JdbcTransactionDriver::open());
        # single results
        assertEq(({"a": 1}, {"a": 2}), executor.executeQuery("multi:rs=a:1,2"));
        assertEq(3, executor.executeUpdate("multi:count=3"));
        assertEq(0, executor.executeUpdate("multi:none"));
        # the update counts of all statements are added
        assertEq(5, executor.executeUpdate("multi:count=2;count=3"));
        assertEq(5, executor.executeUpdateWithParams("multi:count=2;count=0;count=3", (1,)));
        # the rows of a later result set are read and discarded
        assertEq(2, executor.executeUpdate("multi:count=2;rs=a:1"));
    }

    private testQueryExecutorErrors() {
        JdbcTransactionDriver::reset();
        JdbcQueryExecutor executor(JdbcTransactionDriver::open());
        # the errors of later statements are raised
        assertThrows("JNI-ERROR", "later failure", sub () {
            executor.executeUpdate("multi:count=1;fail=later failure");
        });
        assertThrows("JNI-ERROR", "later failure", sub () {
            executor.executeUpdateWithParams("multi:count=1;fail=later failure", (1,));
        });
        assertThrows("JNI-ERROR", "rows failure", sub () {
            executor.executeUpdate("multi:count=1;rowsfail=b:rows failure");
        });
        assertThrows("JNI-ERROR", "later failure", sub () {
            executor.executeQuery("multi:rs=a:1;fail=later failure");
        });
        assertThrows("JNI-ERROR", "later failure", sub () {
            executor.executeQueryWithParams("multi:rs=a:1;count=1;fail=later failure", (1,));
        });
    }

    private testQueryExecutorOneResultSet() {
        JdbcTransactionDriver::reset();
        JdbcQueryExecutor executor(JdbcTransactionDriver::open());
        # a query returns the rows of one result set
        assertEq(({"a": 1},), executor.executeQuery("multi:rs=a:1;count=4"));
        assertThrows("JNI-ERROR", "the SQL of the query returned more than one result set", sub () {
            executor.executeQuery("multi:rs=a:1;rs=b:2");
        });
        assertThrows("JNI-ERROR", "the SQL of the query returned more than one result set", sub () {
            executor.executeQueryWithParams("multi:rs=a:1;rowsfail=b:rows failure", (1,));
        });
    }

    private testChildProviders() {
        if (!jdbc_url) {
            testSkip("no JDBC connection available (QORE_DB_CONNSTR_JDBC_PGSQL not set)");
        }
        JdbcDataProvider dp(getJdbcOptions());
        list<string> children = dp.getChildProviderNames();
        assertTrue(children.size() >= 3);
        assertTrue(inlist("tables", children));
        assertTrue(inlist("query", children));
        assertTrue(inlist("exec", children));
    }

    private testQueryProvider() {
        if (!jdbc_url) {
            testSkip("no JDBC connection available (QORE_DB_CONNSTR_JDBC_PGSQL not set)");
        }
        JdbcDataProvider dp(getJdbcOptions());

        # Create a test table
        AbstractDataProvider execDp = dp.getChildProvider("exec");
        execDp.doRequest({"sql": "CREATE TABLE IF NOT EXISTS jdbc_dp_test (id SERIAL PRIMARY KEY, name VARCHAR(100), value INT)"});

        on_exit {
            execDp.doRequest({"sql": "DROP TABLE IF EXISTS jdbc_dp_test"});
        }

        # Insert data
        execDp.doRequest({"sql": "INSERT INTO jdbc_dp_test (name, value) VALUES ('alpha', 1)"});
        execDp.doRequest({"sql": "INSERT INTO jdbc_dp_test (name, value) VALUES ('beta', 2)"});

        # Query data
        AbstractDataProvider queryDp = dp.getChildProvider("query");
        auto result = queryDp.doRequest({"sql": "SELECT name, value FROM jdbc_dp_test ORDER BY value"});
        assertTrue(result instanceof hash);
        assertGt(0, result.rows.size());
        assertEq(2, result.row_count);
    }

    private testTablesProvider() {
        if (!jdbc_url) {
            testSkip("no JDBC connection available (QORE_DB_CONNSTR_JDBC_PGSQL not set)");
        }
        JdbcDataProvider dp(getJdbcOptions());

        AbstractDataProvider tablesDp = dp.getChildProvider("tables");
        list<hash<auto>> tables = map $1, tablesDp.searchRecords();
        # PostgreSQL always has system tables
        assertTrue(tables.size() >= 0);
    }

    #! the info of a table provider is the info of its class with the name of the table
    private testTableProviderInfo() {
        # the info does not access the database, so the provider does not need a connection
        JdbcTableDataProvider dp("t1", new JdbcSchemaIntrospector(NOTHING), new JdbcQueryExecutor(NOTHING));
        hash<DataProviderInfo> info = dp.getInfo();
        assertEq("t1", info.name);
        # the capabilities of the class are kept
        assertTrue(info.supports_read);
        assertTrue(info.has_record);
        assertEq(JdbcTableDataProvider::ProviderInfo.desc, info.desc);
    }

    private hash<auto> getJdbcOptions() {
        hash<auto> rv = {
            "url": jdbc_url,
            "user": jdbc_user,
            "password": jdbc_password,
        };
        if (jdbc_classpath) {
            rv.classpath = jdbc_classpath;
        }
        if (jdbc_driver_class) {
            rv.driver_class = jdbc_driver_class;
        }
        return rv;
    }
}
