#! the ExcelDataProvider namespace. All classes used in the ExcelDataProvider module should be inside this namespace
public namespace ExcelDataProvider {
#! The Excel data generated from the records written with several worksheets
/** Returned by the \c write-data action, and by
    @ref DataProvider::AbstractDataProvider::finishCreate() "finishCreate()" of
    ExcelDataProvider::ExcelWriteDataProvider, when the workbook is written with the \c sheets option and has no output
    path or stream

    @see @ref ExcelDataProvider_writing_sheets

    @since %ExcelDataProvider 1.1
*/
public hashdecl ExcelGeneratedDataInfo inherits DataProvider::GeneratedDataInfo {
    #! The number of records written to each worksheet, by worksheet name in workbook order
    /** A record written to several worksheets (with \c route \c "all") is counted in each, while \c record_count
        counts it once
    */
    hash<string, int> sheet_counts;
}

#! Describes the Excel data generated by the \c write-data action
/** The generated data and record count of @ref DataProvider::GeneratedDataOutputDataType "GeneratedDataOutputDataType"
    and, for a workbook written with the \c sheets option, the number of records written to each worksheet

    @since %ExcelDataProvider 1.1
*/
public class ExcelGeneratedDataOutputDataType inherits GeneratedDataOutputDataType {
    private {
        #! The fields added to the generated data output fields
        const Fields = {
            "sheet_counts": {
                "display_name": "Worksheet Record Counts",
                "short_desc": "The number of records written to each worksheet",
                "type": new Type("*hash<string, int>"),
                "desc": "The number of records written to each worksheet, by worksheet name in workbook order, "
                    "when the workbook is written with several worksheets (the `sheets` option); a record written "
                    "to several worksheets (with `route` set to `all`) is counted in each, while `record_count` "
                    "counts it once",
            },
        };
    }

    #! Creates the type
    constructor() : GeneratedDataOutputDataType("SpreadsheetGeneratedDataOutput") {
        addQoreFields(Fields);
    }
}

#! Describes the Excel data generated by the \c write-data action
/** @since %ExcelDataProvider 1.1
*/
public const ExcelGeneratedDataOutputDataType = new ExcelGeneratedDataOutputDataType();
}
