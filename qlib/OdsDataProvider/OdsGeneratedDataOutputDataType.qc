#! the OdsDataProvider namespace. All classes used in the OdsDataProvider module should be inside this namespace
public namespace OdsDataProvider {
#! The ODS data generated from the records written with several worksheets
/** Returned by the \c write-data action, and by
    @ref DataProvider::AbstractDataProvider::finishCreate() "finishCreate()" of OdsDataProvider::OdsWriteDataProvider,
    when the document is written with the \c sheets option and has no output path or stream

    @see @ref OdsDataProvider_writing_sheets

    @since %OdsDataProvider 1.0
*/
public hashdecl OdsGeneratedDataInfo inherits DataProvider::GeneratedDataInfo {
    #! The number of records written to each worksheet, by worksheet name in document order
    /** A record written to several worksheets (with \c route \c "all") is counted in each, while \c record_count
        counts it once
    */
    hash<string, int> sheet_counts;
}

#! Describes the ODS data generated by the \c write-data action
/** The generated data and record count of @ref DataProvider::GeneratedDataOutputDataType "GeneratedDataOutputDataType"
    and, for a document written with the \c sheets option, the number of records written to each worksheet

    @since %OdsDataProvider 1.0
*/
public class OdsGeneratedDataOutputDataType inherits GeneratedDataOutputDataType {
    private {
        #! The fields added to the generated data output fields
        const Fields = {
            "sheet_counts": {
                "display_name": "Worksheet Record Counts",
                "short_desc": "The number of records written to each worksheet",
                "type": new Type("*hash<string, int>"),
                "desc": "The number of records written to each worksheet, by worksheet name in document order, "
                    "when the document is written with several worksheets (the `sheets` option); a record written "
                    "to several worksheets (with `route` set to `all`) is counted in each, while `record_count` "
                    "counts it once",
            },
        };
    }

    #! Creates the type
    constructor() : GeneratedDataOutputDataType("SpreadsheetGeneratedDataOutput") {
        addQoreFields(Fields);
    }
}

#! Describes the ODS data generated by the \c write-data action
/** @since %OdsDataProvider 1.0
*/
public const OdsGeneratedDataOutputDataType = new OdsGeneratedDataOutputDataType();
}
